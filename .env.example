# Application Port & Environment
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SQLite CMS Database (lives outside the repo)
# Example Linux: /var/data/bisesj/bisesj.db
# Example Windows: D:/data/bisesj.db
DATABASE_PATH=./data/cms.db

# Feature Flags
# Arabic (/ar) and Bengali (/bn) language routes (English only in prod until Sprint 7)
NEXT_PUBLIC_ENABLE_MULTILINGUAL=false
